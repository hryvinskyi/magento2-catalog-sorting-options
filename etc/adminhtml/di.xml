<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- A category's available and default Sort By lists offer every registered listing sort option -->
    <type name="Magento\Catalog\Model\Category\Attribute\Source\Sortby">
        <plugin name="Hryvinskyi_CatalogSortingOptions::listingSortOptions"
                type="Hryvinskyi\CatalogSortingOptions\Plugin\Catalog\CategorySortBySourceListingSortOptionsPlugin"/>
    </type>

    <!-- The store's default "Product Listing Sort by" offers every registered listing sort option -->
    <type name="Magento\Catalog\Model\Config\Source\ListSort">
        <plugin name="Hryvinskyi_CatalogSortingOptions::listingSortOptions"
                type="Hryvinskyi\CatalogSortingOptions\Plugin\Catalog\ListSortSourceListingSortOptionsPlugin"/>
    </type>
</config>
